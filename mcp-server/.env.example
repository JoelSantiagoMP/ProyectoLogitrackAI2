# API Spring Boot
LOGITRACK_API_BASE_URL=http://localhost:8080

# Usuario con rol AGENTE (JWT; el MCP no usa MySQL)
LOGITRACK_USERNAME=agente_mcp
LOGITRACK_PASSWORD=123456

# Transporte MCP: stdio (Cursor) | streamable-http (n8n) | sse (legacy, no recomendado)
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_STATELESS_HTTP=true
MCP_JSON_RESPONSE=true

# Para n8n (copiar y usar al levantar el servidor HTTP):
# MCP_TRANSPORT=streamable-http
# MCP_HOST=0.0.0.0
# MCP_PORT=3100
